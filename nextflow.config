/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf/SINGLECELL_ANALYSIS config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Author: Jimmy Lucas
    Description: Configuration for single-cell RNA-seq Analysis
    Nextflow Version: >=26.04.4
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

/////////////////////////////////////////////////////////////////////////////////////////
// PARAMS
/////////////////////////////////////////////////////////////////////////////////////////

params {
    project_name                = "default_project"
    mode                        = "qc_process"
  
    config_file                 = "$projectDir/configs/project_config.yaml"

    load_config                 = null
    qc_filter_config            = null
    qc_visualization_config     = null
    doublet_config              = null
    doublet_summary             = null
    doublet_by_sample           = null
    doublet_cell_scores         = null
    approved_doublet_policy     = null
    applied_doublet_policy      = null
    analysis_readiness          = null
    post_doublet_qc_summary     = null
    post_doublet_qc_by_sample   = null
    post_doublet_qc_warnings    = null
    approved_normalization_policy = null
    applied_normalization_policy = null
    dimensionality_npcs          = 30
    dimensionality_summary       = null
    variable_features_summary    = null
    pca_elbow_metrics            = null
    approved_pc_selection_policy = null
    integration_policy           = null
    qc_scores_config            = null
    input_object                = null
    analysis_plan               = null

    /*
    *Scientific metadata.
    */

    project_id                  = null
    biological_run_id           = null


    /*
     * Execution metadata.
     *
     * These parameters allow external orchestrators to track retries,
     * scientific branches, and restarts from previous artifacts.
     */
    
    execution_id                = null
    parent_execution_id         = null
    branch_id                   = null
    objective                   = null
    start_from                  = null
    
    /*
     * Artefact metadata use when restarting from a published result.
    */
    
    input_artifact_stage        = null
    input_artifact_type         = null
    input_artifact              = null


    /*
     * Expected output artifact metadata.
     *
     * Explicit values can override the contract inferred by RUN_MANIFEST
     * from the selected execution mode.
     */
    expected_output_stage       = null
    expected_output_type        = null
    expected_output_path        = null


    outdir                      = "$projectDir/results"
    pipeline_info_dir           = null
    help                        = false

    /*
     * Optional scheduler settings used by the server profiles. Keep
     * site-specific values outside the scientific configuration so the
     * same analysis plan can be moved between installations.
     */
    slurm_queue                 = System.getenv('BBUDY_SLURM_QUEUE') ?: null
    slurm_account               = System.getenv('BBUDY_SLURM_ACCOUNT') ?: null
    hpc_work_dir                = System.getenv('BBUDY_WORK_DIR') ?: null
    hpc_queue_size              = (System.getenv('BBUDY_QUEUE_SIZE') ?: '20') as int
    doublet_cpus                = (System.getenv('BBUDY_DOUBLET_CPUS') ?: '1') as int



/////////////////////////////////////////////////////////////////////////////////////////
//DATA BASES
/////////////////////////////////////////////////////////////////////////////////////////

    //Docker
    r_image = "ghcr.io/jimmlucas/bioc-rnaseq-test01new2:v0.3.0"
    python_image = "ghcr.io/jimmlucas/scrnaseq-control-python@sha256:aa6427fba278d9b83cc9f12cc4152a87c3829344f76dd339c57c31a9c70e81d4"

}    

/////////////////////////////////////////////////////////////////////////////////////////
// PROCESS DEFAULTS
/////////////////////////////////////////////////////////////////////////////////////////

process {

    /*
     * Valores por defecto para procesos ligeros.
     */
    cpus          = 1
    memory        = { 2.GB * task.attempt }
    time          = { 4.h * Math.pow(2, task.attempt - 1) }
    errorStrategy = {
        task.exitStatus in 137..140 || task.exitStatus == 143
            ? 'retry'
            : 'terminate'
    }
    maxRetries    = 2

    withLabel: lightweight {
        cpus   = 1
        memory = { 512.MB * task.attempt }
        time   = { 30.m * Math.pow(2, task.attempt - 1) }
    }

    withLabel: medium_memory {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = { 8.h * Math.pow(2, task.attempt - 1) }
    }

    withLabel: high_memory {
        cpus   = 1
        memory = { 16.GB * task.attempt }
        time   = { 12.h * Math.pow(2, task.attempt - 1) }
    }

    withLabel: very_high_memory {
        cpus     = 1
        memory   = { 32.GB * task.attempt }
        time     = { 72.h * Math.pow(2, task.attempt - 1) }
    }

    /*
     * DoubletFinder can parallelize its parameter sweep. The scheduler
     * allocation is passed to R as --cores so reserved CPUs are used.
     */
    withName: /^(DOUBLET_DETECTION_SCORING|DOUBLET_DETECTION_SCORE_SAMPLE)$/ {
        cpus = params.doublet_cpus
    }

    withName: /^(VALIDATE_ANALYSIS_PLAN|RESOLVE_ANALYSIS_PLAN|INPUT_DISCOVERY|RESOLVE_LOAD_CONFIG|QC_THRESHOLD_RESOLUTION|QC_THRESHOLD_IMPACT_SUMMARY|VALIDATE_QC_THRESHOLD_APPROVAL|DOUBLET_POLICY_RESOLUTION|VALIDATE_DOUBLET_APPROVAL|NORMALIZATION_POLICY_RESOLUTION|VALIDATE_NORMALIZATION_APPROVAL|PC_SELECTION_POLICY_RESOLUTION|VALIDATE_PC_SELECTION_APPROVAL|INTEGRATION_POLICY_RESOLUTION)$/ {
        container = params.python_image
    }
}

/////////////////////////////////////////////////////////////////////////////////////////
// PROFILES
/////////////////////////////////////////////////////////////////////////////////////////

profiles {

    conda {
        conda.enabled        = true
        docker.enabled       = false
        singularity.enabled  = false
        podman.enabled       = false
        shifter.enabled      = false
        charliecloud.enabled = false
    }

    docker {
        docker.enabled       = true
        singularity.enabled  = false
        podman.enabled       = false
        shifter.enabled      = false
        charliecloud.enabled = false
        docker.runOptions    = "--rm"
    }

    singularity {
        docker.enabled          = false
        singularity.enabled     = true
        singularity.autoMounts  = true
        singularity.pullTimeout = '4h'

        process {
            withName: /^(VALIDATE_ANALYSIS_PLAN|RESOLVE_ANALYSIS_PLAN|INPUT_DISCOVERY|RESOLVE_LOAD_CONFIG|QC_THRESHOLD_RESOLUTION|QC_THRESHOLD_IMPACT_SUMMARY|VALIDATE_QC_THRESHOLD_APPROVAL|DOUBLET_POLICY_RESOLUTION|VALIDATE_DOUBLET_APPROVAL|NORMALIZATION_POLICY_RESOLUTION|VALIDATE_NORMALIZATION_APPROVAL|PC_SELECTION_POLICY_RESOLUTION|VALIDATE_PC_SELECTION_APPROVAL|INTEGRATION_POLICY_RESOLUTION)$/ {
                container = "docker://${params.python_image}"
            }
        }
    }

    apptainer {
        docker.enabled        = false
        singularity.enabled   = false
        apptainer.enabled     = true
        apptainer.autoMounts  = true
        apptainer.pullTimeout = '4h'

        process {
            withName: /^(VALIDATE_ANALYSIS_PLAN|RESOLVE_ANALYSIS_PLAN|INPUT_DISCOVERY|RESOLVE_LOAD_CONFIG|QC_THRESHOLD_RESOLUTION|QC_THRESHOLD_IMPACT_SUMMARY|VALIDATE_QC_THRESHOLD_APPROVAL|DOUBLET_POLICY_RESOLUTION|VALIDATE_DOUBLET_APPROVAL|NORMALIZATION_POLICY_RESOLUTION|VALIDATE_NORMALIZATION_APPROVAL|PC_SELECTION_POLICY_RESOLUTION|VALIDATE_PC_SELECTION_APPROVAL|INTEGRATION_POLICY_RESOLUTION)$/ {
                container = "docker://${params.python_image}"
            }
        }
    }

    /*
     * Generic SLURM profile for production servers. Site-specific values
     * are supplied through BBUDY_SLURM_QUEUE, BBUDY_SLURM_ACCOUNT,
     * BBUDY_WORK_DIR and BBUDY_QUEUE_SIZE. The container cache should be
     * set with NXF_SINGULARITY_CACHEDIR on shared storage.
     */
    slurm {
        process {
            executor       = 'slurm'
            queue          = params.slurm_queue
            clusterOptions = params.slurm_account
                ? "--account=${params.slurm_account}"
                : ''

            withName: /^(VALIDATE_ANALYSIS_PLAN|RESOLVE_ANALYSIS_PLAN|INPUT_DISCOVERY|RESOLVE_LOAD_CONFIG|QC_THRESHOLD_RESOLUTION|QC_THRESHOLD_IMPACT_SUMMARY|VALIDATE_QC_THRESHOLD_APPROVAL|DOUBLET_POLICY_RESOLUTION|VALIDATE_DOUBLET_APPROVAL|NORMALIZATION_POLICY_RESOLUTION|VALIDATE_NORMALIZATION_APPROVAL|PC_SELECTION_POLICY_RESOLUTION|VALIDATE_PC_SELECTION_APPROVAL|INTEGRATION_POLICY_RESOLUTION)$/ {
                container = "docker://${params.python_image}"
            }
        }

        executor.queueSize     = params.hpc_queue_size
        workDir                = params.hpc_work_dir ?: "${projectDir}/work"

        docker.enabled         = false
        conda.enabled          = false
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.pullTimeout = '4h'
    }

    /*
     * Perfil para ordenadores con memoria limitada.
     *
     * Se utiliza conjuntamente con Docker:
     *   -profile docker,local_low_memory
     */
    local_low_memory {
        executor.queueSize = 1

        process {
            cpus = 1
        }
    }
}

/////////////////////////////////////////////////////////////////////////////////////////
// REPORTS
/////////////////////////////////////////////////////////////////////////////////////////

report {
    enabled   = true
    file      = "${params.pipeline_info_dir ?: "${params.outdir}/pipeline_info"}/execution_report.html"
    overwrite = true
}

timeline {
    enabled   = true
    file      = "${params.pipeline_info_dir ?: "${params.outdir}/pipeline_info"}/execution_timeline.html"
    overwrite = true
}

trace {
    enabled   = true
    file      = "${params.pipeline_info_dir ?: "${params.outdir}/pipeline_info"}/execution_trace.txt"
    overwrite = true

    fields = 'task_id,hash,native_id,name,status,exit,submit,duration,realtime,%cpu,cpus,memory,peak_rss,peak_vmem,rchar,wchar'
}

dag {
    enabled   = true
    file      = "${params.pipeline_info_dir ?: "${params.outdir}/pipeline_info"}/execution_dag.svg"
    overwrite = true
}
