process QC_VISUALIZATION {

    tag "qc_visualization"
    label "medium_memory"

    publishDir "${params.outdir}/01b_qc_visualization",
        mode: 'copy',
        overwrite: true

    container "${workflow.containerEngine in ['singularity', 'apptainer'] && !task.ext.singularity_pull_docker_container ?
        "docker://${params.r_image}" :
        params.r_image}"

    input:
    tuple val(meta), path(seurat_object)
    path config_file
    path qc_visualization_script

    output:
    tuple val(summary_meta), path("01b_qc_summary.csv"), emit: summary
    tuple val(by_sample_meta), path("01b_qc_by_sample.csv"), emit: by_sample
    tuple val(by_group_meta), path("01b_qc_by_group.csv"), emit: by_group
    tuple val(cell_metadata_meta), path("01b_qc_cell_metadata.csv"), emit: cell_metadata
    tuple val(plots_meta), path("01b_qc_*.png"), emit: plots
    tuple val(session_info_meta), path("01b_sessionInfo.txt"), emit: session_info

    script:

    /*
     * Preserve the scientific identity of the input artifact and record
     * the provenance of the reports generated by this process.
     */
    def output_base_meta = meta + [
        stage                : "qc_visualization",
        source_stage         : meta.stage ?: "",
        source_artifact_type : meta.artifact_type ?: ""
    ]

    summary_meta = output_base_meta + [
        artifact_type: "qc_summary_report"
    ]

    by_sample_meta = output_base_meta + [
        artifact_type: "qc_by_sample_report"
    ]

    by_group_meta = output_base_meta + [
        artifact_type: "qc_by_group_report"
    ]

    cell_metadata_meta = output_base_meta + [
        artifact_type: "qc_cell_metadata"
    ]

    plots_meta = output_base_meta + [
        artifact_type: "qc_plot"
    ]

    session_info_meta = output_base_meta + [
        artifact_type: "session_info"
    ]

    """
    Rscript ${qc_visualization_script} \
        --input ${seurat_object} \
        --config ${config_file}
    """
}
